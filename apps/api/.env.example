# --- runtime ---------------------------------------------------------------
ENVIRONMENT=development                 # development | preview | production
# Supabase pooled connection (Session mode, port 5432 or 6543). Keep this server-side only.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Local development without Postgres:
# DATABASE_URL=sqlite:///./ubcircus.db

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # service role / secret key — API only, never in the frontend
# SUPABASE_JWT_SECRET=                        # only for legacy HS256 projects; JWKS is used by default
STORAGE_BUCKET=media

# --- web -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ubcircus.vercel.app
PUBLIC_SITE_URL=http://localhost:3000

# --- staff bootstrap -------------------------------------------------------
# Emails that receive an admin profile on their first login (no public signup exists).
BOOTSTRAP_ADMIN_EMAILS=

# --- development only ------------------------------------------------------
# Static bearer token accepted ONLY when ENVIRONMENT=development and not on Vercel.
DEV_AUTH_TOKEN=
