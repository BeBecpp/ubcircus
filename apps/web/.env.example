# Content source: "database" reads from the FastAPI service (API_URL); anything else serves labelled sample content.
CONTENT_MODE=database
API_URL=https://ubcircus-api.vercel.app
NEXT_PUBLIC_SITE_URL=https://ubcircus.vercel.app

# Supabase — publishable key only. The secret key never belongs in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local development only (ignored in production builds and on Vercel): lets /admin use a static API token.
# DEV_AUTH_TOKEN=
